sample=c(rep('S1',length(S1)),rep('S2',length(S2))))
ggplot(df,aes(x=sample,y=value))+
geom_boxplot(stat = 'identity',aes(fill=type))
ggplot(df,aes(x=sample,y=value,fill=type))+
geom_boxplot(stat = 'identity',aes(fill=type))
ggplot(df,aes(x=sample,y=value,fill=type))+
geom_boxplot(stat = 'identity')
ggplot(df,aes(x=sample,y=value,fill=type))+
geom_bar(stat = 'identity')
ggplot(df,aes(x=sample,y=value,fill=type))+
geom_line(aes(color=type))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type))+
geom_point(size=6,aes(shape=sample,colour=sample))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=4)+
geom_point(size=6,aes(shape=sample,colour=sample))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=2)+
geom_point(size=3,aes(shape=sample,colour=sample))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=sample,colour=sample))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=type,colour=type))
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=type,colour=type))+
theme_bw() +
theme(
panel.border = element_blank(),panel.grid.major = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid.minor = element_blank(),axis.line = element_line(colour = "black")
)
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=type,colour=type))+
theme_bw() +
theme(
panel.border = element_blank(),panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),axis.line = element_line(colour = "black")
)
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=type,colour=type))+
theme_bw() +
theme(
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.line = element_line(colour = "black"),
panel.border=element_rect(colour = 'black')
)
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=type,colour=type))+
theme_bw() +
theme(
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.line = element_line(colour = "black"),
panel.border=element_rect(fill=NA,color="black", size=5, linetype="solid")
)
ggplot(df,aes(x=sample,y=value,group=type))+
geom_line(aes(color=type),size=1)+
geom_point(size=3,aes(shape=type,colour=type))+
theme_bw() +
theme(
