# Byte-compiled / cache
__pycache__/
*.py[cod]

# Local database (rebuilt from data2db/ via `manage.py load_data`)
*.sqlite3
db.sqlite3

# Collected static files (generated by collectstatic)
staticfiles/

# Uploaded / generated media (keep the directory, ignore its contents)
media/*
!media/.gitkeep

# Environments and secrets
.conda/
.env
.venv/
venv/

# Logs / OS files
*.log
.DS_Store
