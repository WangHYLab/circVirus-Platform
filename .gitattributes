# Normalize text files to LF so Docker/Linux tooling is unaffected by Windows
# checkout settings.
* text=auto
*.py text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.index text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

# Binary assets must never be line-ending converted.
*.zip binary
*.pdf binary
*.xlsx binary
*.xls binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
